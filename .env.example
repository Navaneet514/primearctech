# Required before the audit form can accept submissions.
AUDIT_WEBHOOK_URL=https://example.com/your-secure-webhook
AUDIT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional dedicated PrimeArcTech build-brief destination.
# When blank, build briefs use the audit webhook values above.
BUILD_BRIEF_WEBHOOK_URL=
BUILD_BRIEF_WEBHOOK_SECRET=

# Replace with the final production origin before publishing.
NEXT_PUBLIC_SITE_URL=https://primearc.tech

# Required for public demo sessions. Use at least 32 random characters.
DEMO_SESSION_SECRET=replace-with-a-long-random-secret

# Start with sandbox. Change to vapi only after all Vapi values are configured.
DEMO_PROVIDER=sandbox
DEMO_LIVE_PHONE_NUMBER=
VAPI_ASSISTANT_ID=
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=replace-with-a-different-long-random-secret
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Optional. Live emergency transfers remain disabled when blank.
DEMO_ESCALATION_PHONE_NUMBER=

# Required only for the unlinked private presenter console. Use 16+ characters.
PITCH_ACCESS_SECRET=replace-with-a-long-presenter-password
